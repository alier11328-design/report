# Environment variables / 敏感凭据：严禁提交（代码中一律用环境变量引用）
.env
.env.*
!.env.example

# 私钥与证书文件
*.pem
*.key
*.p12
*.pfx
id_rsa
id_dsa
id_ecdsa
id_ed25519
credentials.json
service-account*.json

# Dependencies (CRITICAL: Don't deploy node_modules to Cloudflare Pages)
node_modules/
.pnpm-store/

# Cache
.npm-cache
.cache/
.temp/
tmp/

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Runtime data
pids
*.pid
*.seed
*.pid.lock

# Dependency directories
jspm_packages/
bower_components/

# TypeScript cache
*.tsbuildinfo

# Optional npm cache directory
.npm

# Optional eslint cache
.eslintcache

# Microbundle cache
.rpt2_cache/
.rts2_cache_cjs/
.rts2_cache_es/
.rts2_cache_umd/

# Optional REPL cache
.node_repl_history

# Output of 'npm pack'
*.tgz

# Yarn Integrity file
.yarn-integrity

# dotenv environment variables
.env.development.local
.env.test.local
.env.production.local

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# OS generated files
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# Platform specific
.vercel/
.edgeone/
.netlify/
.cloudflare/
.wrangler/
wrangler.toml

# Project specific
backups/
*.bak

# 视觉校验产物（scripts/*.mjs 生成的对照截图，不入库）
scripts/_verify/

# 本地工具副产物（AI 项目记忆 / 设计工具元数据，不入库）
.workbuddy/
.hallmark/
